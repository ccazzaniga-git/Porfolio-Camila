<div class="container" style="margin-top: 50px;">

    {{!-- botón para volver --}}
    <div class="row">
        <div class="col-7">
            <h2 class="mb-4">Modificar Producto n° {{producto.id}}</h2>
        </div>
        <div class="col-5 text-end">
            <a class="btn btn-secondary" href="/admin/productos"><i class="fa fa-arrow-left" aria-hidden="true"></i>
                Volver</a>
        </div>
    </div>

    {{!-- Formulario --}}
    <div class="row justify-content-center">
        <div class="col-md-8">
            <form method="post" action="/admin/productos/modificar" class="bg-light p-4 rounded border shadow-sm" enctype="multipart/form-data">

                <input type="hidden" name="id" value="{{producto.id}}">

                {{!-- Campo Título --}}
                <div class="mb-3">
                    <label for="titulo" class="form-label font-weight-bold"> Servicio </label>
                    <input type="text" class="form-control" name="titulo" value="{{producto.titulo}}">
                </div>

                {{!-- Campo Subtítulo --}}
                <div class="mb-3">
                    <label for="subtitulo" class="form-label"> Servicios que incluye </label>
                    <input type="text" class="form-control" name="subtitulo" value="{{producto.subtitulo}}">
                </div>

                {{!-- Campo Cuerpo --}}
                <div class="mb-3">
                    <label for="cuerpo" class="form-label">Descripción</label>
                    <textarea class="form-control" name="cuerpo">{{producto.cuerpo}}</textarea>
                </div>

                {{!-- Campo Imagen --}}
                <div class="mb-4">
                    <label for="imagen" class="form-label">Imagen</label>
                    <input type="file" id="imagen" name="imagen">
                </div>
                <div class="mb-4">
                    <label><input type="checkbox" name="img_delete" id="img_delete" value="1"> Eliminar imagen
                        actual</label>
                    <input type="hidden" name="img_original" value="{{producto.img_id}}">
                </div>

                {{!-- Campo Precio --}}
                <div class="mb-4">
                    <label for="precio" class="form-label">Valor</label>
                    <input type="number" step="0.01" min="0" class="form-control" name="precio"
                        value="{{producto.precio}}">
                </div>

                {{!-- Botones de acción --}}
                <div class="d-flex justify-content-end gap-2">
                    <button type="submit" class="btn btn-success"><i class="fa fa-save" aria-hidden="true"></i> Guardar
                        modificación</button>
                </div>

            </form>

            {{!-- Mensaje de error (si falla la validación en el servidor) --}}
            {{#if error}}
            <p class="text-danger">No se pudo modificar el producto</p>
            {{/if}}


        </div>
    </div>

    {{!-- cierre cuenta --}}
    <div class="row">
        <p class="text-end">Chau {{usuario}}! <a class="btn btn-outline-danger" href="/admin/login/logout">Cerrar sesión
                <i class="fas fa-sign-out-alt"></i></a></p>
    </div>
</div>