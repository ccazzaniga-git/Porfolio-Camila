<div class="container" style="margin-top: 50px;">

    {{!-- botón para volver --}}
    <div class="row">
        <div class="col-6 offset-3">
            <h2 class="mb-4">Modificar Producto</h2>
        </div>
        <div class="col-5 text-end">
            <a class="btn btn-secondary" href="/admin/productos"><i class="fa fa-arrow-left" aria-hidden="true"></i>
                Volver</a>
        </div>
    </div>

    {{!-- Formulario modificacion--}}
    <div class="row justify-content-center">
        <div class="col-6 offset-3">
            <form method="post" action="/admin/productos/modificar/{{producto.id}}" class="bg-light p-4 rounded border shadow-sm">

                {{!-- Campo Título --}}
                <div class="mb-3">
                    <label for="titulo" class="form-label font-weight-bold"> Servicio </label>
                    <input type="text" class="form-control" id="titulo" name="titulo" placeholder="Ejemplo: Diseño Web" required>
                </div>

                {{!-- Campo Subtítulo --}}
                <div class="mb-3">
                    <label for="subtitulo" class="form-label"> Servicios que incluye </label>
                    <input type="text" class="form-control" id="subtitulo" name="subtitulo"
                        placeholder="Ejemplo: Diseño y desarrollo full stack" required>
                </div>

                {{!-- Campo Cuerpo --}}
                <div class="mb-3">
                    <label for="cuerpo" class="form-label">Descripción</label>
                    <textarea class="form-control" id="cuerpo" name="cuerpo" rows="4"
                        placeholder="Detalles del servicio..." required></textarea>
                </div>

                {{!-- Campo Precio --}}
                <div class="mb-4">
                    <label for="precio" class="form-label">Valor</label>
                    <input type="number" step="0.01" min="0" class="form-control" id="precio" name="precio"
                        placeholder="0.00" required>
                </div>

                {{!-- Botones de acción --}}
                <div class="d-flex justify-content-end gap-2">
                    <button type="submit" class="btn btn-success"><i class="fa fa-save" aria-hidden="true"></i> Guardar
                        Producto</button>
                </div>

            </form>

            {{!-- Mensaje de error (si falla la validación en el servidor) --}}
            {{#if error}}
            <div class="alert alert-danger" role="alert">
                {{message}}
            </div>
            {{/if}}


        </div>
    </div>

    {{!-- cierre cuenta --}}
    <div class="row">
        <p class="text-end">Chau {{usuario}}! <a class="btn btn-outline-danger" href="/admin/login/logout">Cerrar sesión
                <i class="fas fa-sign-out-alt"></i></a></p>
    </div>
</div>