<div class="container" style="margin-top: 50px;">

    {{!-- Título con botón para volver al listado --}}
    <div class="row">
        <div class="col-7">
            <h2 class="mb-4">Agregar Nuevo Producto</h2>
        </div>
        <div class="col-5 text-end">
            <a class="btn btn-secondary" href="/admin/productos"><i class="fa fa-arrow-left" aria-hidden="true"></i> Volver</a>
        </div>
    </div>

    {{!-- Formulario de alta --}}
    <div class="row justify-content-center">
        <div class="col-md-8">
            <form action="/admin/productos/agregar" method="post" class="bg-light p-4 rounded border shadow-sm">
                
                {{!-- Campo Título --}}
                <div class="mb-3">
                    <label for="titulo" class="form-label font-weight-bold">Título / Servicio</label>
                    <input type="text" class="form-control" id="titulo" name="titulo" placeholder="Ej: Diseño Web" required>
                </div>

                {{!-- Campo Subtítulo --}}
                <div class="mb-3">
                    <label for="subtitulo" class="form-label">Subtítulo</label>
                    <input type="text" class="form-control" id="subtitulo" name="subtitulo" placeholder="Ej: Desarrollo a medida" required>
                </div>

                {{!-- Campo Descripción --}}
                <div class="mb-3">
                    <label for="descripcion" class="form-label">Descripción</label>
                    <textarea class="form-control" id="descripcion" name="descripcion" rows="4" placeholder="Detalles del producto o servicio..." required></textarea>
                </div>

                {{!-- Campo Precio / Valor --}}
                <div class="mb-4">
                    <label for="valor" class="form-label">Valor ($)</label>
                    <input type="number" step="0.01" min="0" class="form-control" id="valor" name="valor" placeholder="0.00" required>
                </div>

                {{!-- Mensaje de error (si falla la validación en el servidor) --}}
                {{#if error}}
                    <div class="alert alert-danger" role="alert">
                        {{message}}
                    </div>
                {{/if}}

                {{!-- Botones de acción --}}
                <div class="d-flex justify-content-end gap-2">
                    <button type="submit" class="btn btn-success"><i class="fa fa-save" aria-hidden="true"></i> Guardar Producto</button>
                </div>

            </form>
        </div>
    </div>

    {{!-- cierre cuenta --}}
    <div class="row">
        <p class="text-end">Chau {{usuario}}! <a class="btn btn-outline-danger" href="/admin/login/logout">Cerrar sesión
                <i class="fas fa-sign-out-alt"></i></a></p>
    </div>
</div>
